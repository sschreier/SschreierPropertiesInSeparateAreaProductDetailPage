{% set propertiesTabId = 'properties-tab-' ~ product.id %}

<li class="nav-item">
    <a class="nav-link product-detail-tab-navigation-link product-detail-properties-tab-{{ product.id }}"
        id="{{ propertiesTabId }}"
        data-bs-toggle="tab"
        data-off-canvas-tabs="true"
        href="#{{ propertiesTabId }}-pane"
        role="tab"
        aria-controls="{{ propertiesTabId }}-pane"
        aria-selected="false">
        <span>
            {% block propertiesinseparateareaproductdetailpage_custom_tab_properties_title %}
                {{ "sschreier.propertiesinseparateareaproductdetailpage.title"|trans }}
            {% endblock %}
        </span>
        <span class="product-detail-tab-navigation-icon">
            {% sw_icon 'arrow-medium-right' style {'pack':'solid'} %}
        </span>
        <span class="product-detail-tab-preview">
            {% block propertiesinseparateareaproductdetailpage_custom_tab_properties_preview %}
               {{ "sschreier.propertiesinseparateareaproductdetailpage.tab.previewMore"|trans }}
            {% endblock %}
        </span>
    </a>
</li>
